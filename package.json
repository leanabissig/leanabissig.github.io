{
  "name": "leana-bissig-website",
  "version": "1.0.0",
  "description": "Leana Bissig's athlete website, built with Astro into static pages for GitHub Pages.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/deck-pdf.mjs",
    "check": "astro check",
    "preview": "npm run build && python3 -m http.server 8000 --directory dist",
    "test": "npm run build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leanabissig/leanabissig.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/leanabissig/leanabissig.github.io/issues"
  },
  "homepage": "https://github.com/leanabissig/leanabissig.github.io#readme",
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.5",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
