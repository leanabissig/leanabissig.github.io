---
import ArrowIcon from "./ArrowIcon.astro";
import Coins from "./Coins.astro";
import Lines from "./Lines.astro";
import Results from "./Results.astro";
import Season from "./Season.astro";
import { profile } from "../data/profile";
import { texts, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = texts[lang];
---

<section id="highlights" class="panel" aria-labelledby="highlights-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{t.highlightsEyebrow}</p>
      <h2 id="highlights-heading"><Lines text={t.highlightsHeading} /></h2>
    </div>
    <a class="text-link" href={profile.pto} target="_blank" rel="noopener noreferrer"
      ><span>{t.allResults}</span> <span aria-hidden="true"><ArrowIcon /></span></a
    >
  </div>
  <Results lang={lang} />
  <Coins lang={lang} />
  <Season lang={lang} />
  <aside class="goal">
    <div>
      <p class="eyebrow">{t.goalEyebrow}</p>
      <h3>{t.goalHeading}</h3>
    </div>
    <p>{t.goalText}</p>
  </aside>
</section>
