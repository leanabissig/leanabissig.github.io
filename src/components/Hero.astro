---
import ArrowIcon from "./ArrowIcon.astro";
import { profile } from "../data/profile";
import { texts, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = texts[lang];
const photos = [
  { name: "bike-portrait", alt: t.photoBikePortrait },
  { name: "bike-action", alt: t.photoCycling },
  { name: "after-race", alt: t.photoAfterRace },
];
const image = (name: string, width: number) => `/assets/onepager/images/${name}-${width}.webp`;
const contactMail = `mailto:${profile.email}?subject=${encodeURIComponent(t.mailSubjectContact)}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">{t.heroEyebrow}</p>
    <h1 id="hero-title">Leana<br />Bissig<span>.</span></h1>
  </div>
  <div class="hero-media">
    <div class="hero-photos" role="group" aria-label={t.photosLabel}>
      {
        photos.map((photo, index) => (
          <img
            class="hero-photo"
            src={image(photo.name, 1200)}
            srcset={`${image(photo.name, 640)} 640w, ${image(photo.name, 1200)} 1200w`}
            sizes="(max-width:700px) calc(100vw - 36px), 535px"
            width="1200"
            height="1800"
            alt={photo.alt}
            fetchpriority={index === 0 ? "high" : undefined}
            loading={index === 0 ? undefined : "lazy"}
            hidden={index > 0}
          />
        ))
      }
    </div>
    <div class="photo-controls" hidden>
      <button type="button" id="previous-photo" aria-label={t.previousPhoto}>←</button><span
        id="photo-count"
        aria-live="polite"
        aria-atomic="true">01 / 03</span
      ><button type="button" id="next-photo" aria-label={t.nextPhoto}>→</button>
    </div>
  </div>
</section>
<div class="intro">
  <p class="intro-description">{t.introText}</p>
  <div class="social-links" aria-label={t.socialLinks}>
    <a href={profile.instagram} target="_blank" rel="noopener noreferrer"
      ><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none"></circle></svg
      >Instagram<span class="social-arrow" aria-hidden="true"><ArrowIcon /></span></a
    >
    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"
      ><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="9" width="3.5" height="12"></rect>
        <circle cx="4.75" cy="4.75" r="2"></circle>
        <path
          d="M10 9h3.4v1.6c1-1.4 2.2-1.9 3.6-1.9 3.1 0 4.4 1.9 4.4 5.3v7H18v-6.2c0-2-.5-3.2-2.2-3.2-1.8 0-2.4 1.3-2.4 3.2V21H10Z"
        ></path></svg
      >LinkedIn<span class="social-arrow" aria-hidden="true"><ArrowIcon /></span></a
    >
    <a href={contactMail}
      ><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m4 6 8 6 8-6"></path></svg
      ><span>{t.contact}</span><span class="social-arrow" aria-hidden="true"><ArrowIcon /></span></a
    >
  </div>
</div>
